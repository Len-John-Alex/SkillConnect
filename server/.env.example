# ─────────────────────────────────────────────────────────────────
#  SkillConnect Server — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# How to create the database:
#   psql -U postgres
#   CREATE USER skillconnect_user WITH PASSWORD 'your_password';
#   CREATE DATABASE skillconnect OWNER skillconnect_user;
#   \q
#
# Then set DATABASE_URL below and run:
#   npm run db:migrate            ← apply schema
#   npm run db:migrate:seed       ← apply schema + seed dev data
#
# Default local development connection (adjust username/password if needed)
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillconnect

# Authentication (must be at least 32 characters in production)
JWT_SECRET=dev_jwt_access_secret_skillconnect_development_only_2026
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_skillconnect_development_only_2026

# Institution registration invite code
INSTITUTION_INVITE_CODE=INST_2026_SKILLCONNECT

# CORS – comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Cookie settings
COOKIE_SECURE=false  # Set to true in production with HTTPS
COOKIE_SAME_SITE=lax  # 'strict' | 'lax' | 'none'
