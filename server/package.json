{
  "name": "skillconnect-server",
  "version": "1.0.0",
  "description": "SkillConnect Express API server",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:seed": "node src/db/migrate.js --seed",
    "db:seed": "node -e \"require('dotenv').config(); const {Pool}=require('pg'); const fs=require('fs'); const p=new Pool({connectionString:process.env.DATABASE_URL}); p.query(fs.readFileSync('src/db/seeds/seed.sql','utf8')).then(()=>{console.log('Seeded.');p.end()}).catch(e=>{console.error(e.message);p.end();process.exit(1)})\"",
    "db:seed:demo": "node src/db/seeds/populate_demo_data.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
