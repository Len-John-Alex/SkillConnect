# ─────────────────────────────────────────────────────────────────
#  SkillConnect Client — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
#  All client-side variables MUST start with VITE_ to be exposed
#  by Vite's build pipeline.
# ─────────────────────────────────────────────────────────────────

# Base URL for all API requests from the frontend
VITE_API_BASE_URL=http://localhost:5000/api
